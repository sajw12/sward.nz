# Force LF for all text files so the SHA-256 in _headers (CSP) stays
# byte-stable across checkouts and matches what Cloudflare serves.
* text=auto eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.svg  text eol=lf
*.xml  text eol=lf
*.txt  text eol=lf
*.md   text eol=lf
